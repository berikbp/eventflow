  "narrative": {
    "northStar": "Forest-and-lime event marketplace",
    "overview": "EventFlow uses the confirmed forest-and-lime event marketplace direction: warm near-white pages, deep green text, restrained borders and community imagery. Russian interface copy and compact organizer tools keep discovery approachable and operational screens readable.\n\nThe recurring date block connects event listings, detail pages and tickets. Local photographs illustrate the two seeded events; other events receive a typographic poster. Short state transitions support interaction without entrance choreography.",
    "keyCharacteristics": [
      "Forest ink and lime emphasis on warm paper.",
      "Onest throughout, with compact labels and balanced headings.",
      "Image-led discovery and a recurring day/month date block.",
      "Flat bordered surfaces and explicit status labels."
    ],
    "rules": [
      {
        "name": "The Date Continuity Rule",
        "body": "Carry the same day/month block from discovery to detail to ticket; derive its content from the event date.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate working surfaces with pale fills and fine borders; reserve text shadow for the photograph caption.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared forest, paper and lime palette and Onest type family.",
      "Do preserve visible focus indicators and reduced-motion behavior.",
      "Do label participant values on small screens and allow long emails and ticket codes to wrap.",
      "Do keep event imagery illustrative and status values grounded in actual event data."
    ],
    "donts": [
      "Don't present illustrative photographs as evidence of a particular event.",
      "Don't introduce account, payment, venue or rating cues unsupported by the product.",
      "Don't replace explicit ticket and queue labels with color alone."
    ]
  }
}
