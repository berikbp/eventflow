# Local development only. Change credentials before deployment.
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow_local
POSTGRES_DB=eventflow
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://eventflow:eventflow_local@localhost:5433/eventflow
API_PROXY_TARGET=http://127.0.0.1:8000
# Generate a random token (at least 32 characters) for organizer write access.
# Empty token disables write endpoints; never set a VITE_ variable for this secret.
ORGANIZER_TOKEN=

# Local SMTP (Mailpit); Compose worker uses the mailpit service hostname.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=EventFlow <noreply@eventflow.local>
PUBLIC_BASE_URL=http://localhost:5173
